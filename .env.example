# Copy this file to .env.local and fill it in. .env.local is never committed.

# Password for the admin panel at /admin
ADMIN_PASSWORD=

# 32+ random characters used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional: folder for content.json and messages.json (default: ./data)
# DATA_DIR=
